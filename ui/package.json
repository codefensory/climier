    "@tailwindcss/vite": "^4.1.11",
    "babel-preset-solid": "^1.9.15",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.6"
  },
  "engines": {
    "node": ">=20"
