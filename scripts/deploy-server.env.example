# Copy to .deploy.env (gitignored), or export these variables.
# The remote only needs the compiled binary, ui/dist, and the private config.

# SSH host and absolute deployment root.
CLIMIER_DEPLOY_REMOTE="<ssh-host>:/srv/climier"
# Bun target for the host architecture.
CLIMIER_DEPLOY_TARGET="linux-arm64"
# systemd unit whose ExecStart points at the deployed binary and server.json.
CLIMIER_DEPLOY_SERVICE="climier-server.service"
# Origin reachable from the remote host for health and asset checks.
CLIMIER_DEPLOY_URL="https://<host>"

# Optional paths (defaults are relative to CLIMIER_DEPLOY_REMOTE):
# CLIMIER_DEPLOY_CONFIG="/srv/climier/server.json"
# CLIMIER_DEPLOY_BINARY="/srv/climier/climier-server"
# CLIMIER_DEPLOY_UI_ROOT="/srv/climier/ui/dist"
# CLIMIER_DEPLOY_HEALTH_URL="https://<host>/"
