# Copiá este archivo a `.deploy.env` (ignorado por git) y completá los valores.
# También podés exportar estas variables o apuntar CLIMIER_DEPLOY_ENV a otro archivo.

# Host SSH y path del checkout del server: `<host>:<path>`.
CLIMIER_DEPLOY_REMOTE="<ssh-host>:<path-to-server-checkout>"
# Unidad systemd del server.
CLIMIER_DEPLOY_SERVICE="climier-server.service"
# Origen donde el server sirve la UI; vacío para saltear la verificación por HTTP.
CLIMIER_DEPLOY_URL="http://<host>:<port>"

# Opcionales (defaults del script):
# CLIMIER_DEPLOY_BRANCH="deploy/hosted-ui"
# CLIMIER_DEPLOY_BASE="deploy-base"
# CLIMIER_DEPLOY_UI="ui"
