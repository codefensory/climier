{
  "name": "@climier/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite dev",
    "sync:canonical": "bun scripts/sync-canonical.mjs",
    "search:build": "bun scripts/build-search.mjs",
    "build": "bun run sync:canonical && vite build && bun run search:build",
    "prerender": "bun run build",
    "start": "vite preview --outDir .output/public",
    "preview": "vite preview --outDir .output/public",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "26.6.4",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "zbsearch": "4.0.1"
  }
}
